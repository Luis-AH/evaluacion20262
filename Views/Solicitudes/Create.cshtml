@model evaluacion20262.Models.SolicitudServicio

@{
    ViewData["Title"] = "Registrar Solicitud";
}

<div class="mt-4">
    <h1 class="page-title"><span class="highlight">Registrar</span> Solicitud</h1>
    <p class="page-subtitle">Complete el formulario para registrar una nueva solicitud de servicio técnico.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-tecnogas mb-4">
        @TempData["SuccessMessage"]
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="glass-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Cliente" class="form-label">Cliente</label>
                    <input asp-for="Cliente" class="form-control" placeholder="Nombre completo del cliente" />
                    <span asp-validation-for="Cliente" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ej: 999-888-777" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distrito" class="form-label">Distrito</label>
                        <input asp-for="Distrito" class="form-control" placeholder="Ej: Miraflores" />
                        <span asp-validation-for="Distrito" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TipoServicio" class="form-label">Tipo de Servicio</label>
                    <select asp-for="TipoServicio" class="form-select">
                        <option value="">— Seleccione una opción —</option>
                        <option value="Instalación">Instalación</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="Revisión">Revisión</option>
                        <option value="Fuga">Fuga</option>
                    </select>
                    <span asp-validation-for="TipoServicio" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label">Descripción <small style="color: var(--text-muted);">(opcional)</small></label>
                    <textarea asp-for="Descripcion" class="form-control" placeholder="Detalle adicional sobre la solicitud..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn-tecnogas btn-primary-tecnogas">Registrar Solicitud</button>
                    <a asp-action="Index" class="btn-tecnogas btn-outline-tecnogas">Ver Listado</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

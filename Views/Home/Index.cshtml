@{
    ViewData["Title"] = "Inicio";
}

<div class="mt-4">
    <h1 class="page-title">Bienvenido a <span class="highlight">TecnoGas Hogar</span></h1>
    <p class="page-subtitle">Sistema de gestión de solicitudes de servicio técnico de gas doméstico.</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-value"></div>
        <div class="stat-label">Instalación</div>
    </div>
    <div class="stat-card">
        <div class="stat-value"></div>
        <div class="stat-label">Mantenimiento</div>
    </div>
    <div class="stat-card">
        <div class="stat-value"></div>
        <div class="stat-label">Revisión</div>
    </div>
    <div class="stat-card">
        <div class="stat-value"></div>
        <div class="stat-label">Fuga</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="glass-card">
            <h4 style="font-family: var(--font-display); font-weight: 700; margin-bottom: 0.75rem;">
                Registrar Solicitud
            </h4>
            <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
                Complete el formulario para generar una nueva solicitud de servicio técnico para un cliente.
            </p>
            <a asp-controller="Solicitudes" asp-action="Create" class="btn-tecnogas btn-primary-tecnogas">
                Ir al Formulario
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glass-card">
            <h4 style="font-family: var(--font-display); font-weight: 700; margin-bottom: 0.75rem;">
                Ver Solicitudes
            </h4>
            <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
                Consulte el listado completo de solicitudes registradas, ordenadas por fecha.
            </p>
            <a asp-controller="Solicitudes" asp-action="Index" class="btn-tecnogas btn-outline-tecnogas">
                Ver Listado
            </a>
        </div>
    </div>
</div>
